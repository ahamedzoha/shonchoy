{
  "extends": "@workspace/typescript-config/vite.json",
  "include": ["src"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@features/*": ["./src/features/*"],
      "@hooks/*": ["./src/common/hooks/*"],
      "@utils/*": ["./src/utils/*"],
      "@config/*": ["./src/config/*"],
      "@locales/*": ["./src/locales/*"],
      "@store/*": ["./src/store/*"],
      "@routes/*": ["./src/routes/*"],
      "@types/*": ["./src/types/*"]
    }
  }
}
